<?xml version="1.0"?>
<sdf version="1.6">
  <model name="obstacle_course">
    <static>true</static>

    <!-- Central low wall -->
    <link name="central_wall">
      <collision name="central_wall_collision">
        <geometry>
          <box>
            <size>0.5 1.0 0.5</size>
          </box>
        </geometry>
        <pose>2.0 0 0.25 0 0 0</pose>
      </collision>
      <visual name="central_wall_visual">
        <geometry>
          <box>
            <size>0.5 1.0 0.5</size>
          </box>
        </geometry>
        <pose>2.0 0 0.25 0 0 0</pose>
        <material>
          <ambient>0.7 0.5 0.3 1</ambient>
          <diffuse>0.9 0.7 0.5 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Step platforms -->
    <link name="step_1">
      <collision name="step_1_collision">
        <geometry>
          <box>
            <size>0.8 0.8 0.3</size>
          </box>
        </geometry>
        <pose>3.5 0.5 0.15 0 0 0</pose>
      </collision>
      <visual name="step_1_visual">
        <geometry>
          <box>
            <size>0.8 0.8 0.3</size>
          </box>
        </geometry>
        <pose>3.5 0.5 0.15 0 0 0</pose>
        <material>
          <ambient>0.4 0.4 0.6 1</ambient>
          <diffuse>0.6 0.6 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="step_2">
      <collision name="step_2_collision">
        <geometry>
          <box>
            <size>0.8 0.8 0.3</size>
          </box>
        </geometry>
        <pose>4.3 0.5 0.45 0 0 0</pose>
      </collision>
      <visual name="step_2_visual">
        <geometry>
          <box>
            <size>0.8 0.8 0.3</size>
          </box>
        </geometry>
        <pose>4.3 0.5 0.45 0 0 0</pose>
        <material>
          <ambient>0.4 0.4 0.6 1</ambient>
          <diffuse>0.6 0.6 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Raised narrow platform -->
    <link name="narrow_platform">
      <collision name="narrow_platform_collision">
        <geometry>
          <box>
            <size>1.0 0.4 0.2</size>
          </box>
        </geometry>
        <pose>1.5 -1.0 0.2 0 0 0</pose>
      </collision>
      <visual name="narrow_platform_visual">
        <geometry>
          <box>
            <size>1.0 0.4 0.2</size>
          </box>
        </geometry>
        <pose>1.5 -1.0 0.2 0 0 0</pose>
        <material>
          <ambient>0.5 0.5 0.4 1</ambient>
          <diffuse>0.7 0.7 0.6 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Slope element -->
    <link name="slope">
      <collision name="slope_collision">
        <geometry>
          <box>
            <size>1.5 0.6 0.1</size>
          </box>
        </geometry>
        <pose>0.5 1.5 0.35 0 0 0.46365</pose>
      </collision>
      <visual name="slope_visual">
        <geometry>
          <box>
            <size>1.5 0.6 0.1</size>
          </box>
        </geometry>
        <pose>0.5 1.5 0.35 0 0 0.46365</pose>
        <material>
          <ambient>0.3 0.5 0.4 1</ambient>
          <diffuse>0.5 0.7 0.6 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
