<?xml version="1.0"?>
<sdf version="1.6">
  <model name="imu_sensor">
    <static>true</static>
    <pose>0 0 1.0 0 0 0</pose>

    <!-- Link -->
    <link name="imu_link">
      <collision name="collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.02</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.0 0.8 1</ambient>
          <diffuse>0.8 0.0 0.8 1</diffuse>
        </material>
      </visual>

      <!-- IMU Sensor -->
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200.0</update_rate>

        <imu>
          <noise>
            <type>gaussian</type>
            <rate>
              <mean>0</mean>
              <stddev>0.0</stddev>
            </rate>
            <acceleration>
              <mean>0</mean>
              <stddev>0.0</stddev>
            </acceleration>
          </noise>
        </imu>

        <!-- ROS2 Plugin -->
        <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>/sensors</namespace>
            <remapping>imu/data:=imu/data</remapping>
          </ros>
          <frame_name>imu_link</frame_name>
          <topic_name>imu/data</topic_name>
          <update_rate>200.0</update_rate>
          <gaussian_noise>0.0</gaussian_noise>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
