<?xml version="1.0"?>
<sdf version="1.6" xmlns:xi="http://www.w3.org/2001/XInclude">
  <world name="transformer_world">
    <!-- Physics Settings -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.80665</gravity>
      <ode>
        <solver_type>quick</solver_type>
        <min_step_size>0.0001</min_step_size>
        <iters>50</iters>
        <precon_iters>0</precon_iters>
        <sor>1.3</sor>
        <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
      </ode>
    </physics>

    <!-- Ambient Light -->
    <ambient>0.3 0.3 0.3 1</ambient>

    <!-- Sun Light -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <direction>-1 -1 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Spawn Points Documentation (referenced in config/spawn_points.yaml) -->
    <!--
      Spawn locations for robot configurations:
      - Humanoid spawn: [0, 0, 0.1] with orientation 0 (facing +X)
      - Vehicular spawn: [5, 0, 0.2] with orientation 0 (facing +X)
      These coordinates are documented in config/spawn_points.yaml
    -->

    <!-- OBSTACLES FOR TRANSFORMATION TESTING -->

    <!-- Ramp: Tests climbing capability for both vehicular and humanoid forms -->
    <include>
      <uri>model://ramp</uri>
      <pose>3.0 2.0 0 0 0 0</pose>
    </include>

    <!-- Platform: Elevated surface requiring transformation/climbing to access -->
    <include>
      <uri>model://platform</uri>
      <pose>-3.0 2.0 0 0 0 0</pose>
    </include>

    <!-- Wall: Barrier requiring navigation or transformation to overcome -->
    <include>
      <uri>model://wall</uri>
      <pose>0.0 -3.0 0 0 0 1.5708</pose>
    </include>

     <!-- Obstacle Course: Combined challenges for comprehensive testing -->
     <include>
       <uri>model://obstacle_course</uri>
       <pose>-5.0 -2.0 0 0 0 0</pose>
     </include>

     <!-- SENSOR PLACEMENTS FOR ROBOT PERCEPTION TESTING -->

     <!-- RGB Camera: Overhead view of the transformation area -->
     <include>
       <uri>model://rgb_camera</uri>
       <pose>0.0 0.0 6.0 0 0 0</pose>
     </include>

     <!-- LIDAR 2D: Perimeter scanning at multiple elevations -->
     <include>
       <uri>model://lidar_2d</uri>
       <pose>-8.0 0.0 0.5 0 0 0</pose>
     </include>

     <include>
       <uri>model://lidar_2d</uri>
       <pose>8.0 0.0 0.5 0 0 0</pose>
     </include>

     <include>
       <uri>model://lidar_2d</uri>
       <pose>0.0 8.0 0.5 0 0 -1.5708</pose>
     </include>

     <!-- IMU Sensor: Near spawn points for orientation reference -->
     <include>
       <uri>model://imu_sensor</uri>
       <pose>0.0 0.0 0.2 0 0 0</pose>
     </include>

   </world>
 </sdf>
