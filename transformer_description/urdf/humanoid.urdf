<?xml version="1.0"?>
<robot name="humanoid" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Material definitions -->
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <!-- Base link (fixed to world) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Torso with 3 DOF -->
  <link name="torso_base">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/torso_base.stl"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.2 0.4"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="torso_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="torso_base"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <joint name="torso_pitch" type="revolute">
    <parent link="torso_base"/>
    <child link="torso_pitch_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="50" velocity="1.0" lower="-0.5" upper="0.5"/>
  </joint>

  <link name="torso_pitch_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/torso_mid.stl"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.25 0.18 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.06" iyz="0.0" izz="0.04"/>
    </inertial>
  </link>

  <joint name="torso_roll" type="revolute">
    <parent link="torso_pitch_link"/>
    <child link="torso_roll_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" velocity="1.0" lower="-0.3" upper="0.3"/>
  </joint>

  <link name="torso_roll_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/torso_top.stl"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.15 0.25"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.04" iyz="0.0" izz="0.03"/>
    </inertial>
  </link>

  <!-- Head with 2 DOF -->
  <joint name="head_pan" type="revolute">
    <parent link="torso_roll_link"/>
    <child link="head_pan_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="20" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <link name="head_pan_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/head_base.stl"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>

  <joint name="head_tilt" type="revolute">
    <parent link="head_pan_link"/>
    <child link="head_tilt_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="20" velocity="1.0" lower="-0.5" upper="0.5"/>
  </joint>

  <link name="head_tilt_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/head_dome.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <!-- Left Arm (3 DOF) -->
  <joint name="left_shoulder_pitch" type="revolute">
    <parent link="torso_roll_link"/>
    <child link="left_shoulder_pitch_link"/>
    <origin xyz="0.12 -0.08 0.08" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="30" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <link name="left_shoulder_pitch_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/shoulder_joint.stl"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="left_shoulder_roll" type="revolute">
    <parent link="left_shoulder_pitch_link"/>
    <child link="left_upper_arm_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <link name="left_upper_arm_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/upper_arm.stl"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.12" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="left_elbow" type="revolute">
    <parent link="left_upper_arm_link"/>
    <child link="left_lower_arm_link"/>
    <origin xyz="0 -0.06 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="20" velocity="1.0" lower="-1.57" upper="0"/>
  </joint>

  <link name="left_lower_arm_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/lower_arm.stl"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <!-- Right Arm (3 DOF) - mirror of left -->
  <joint name="right_shoulder_pitch" type="revolute">
    <parent link="torso_roll_link"/>
    <child link="right_shoulder_pitch_link"/>
    <origin xyz="-0.12 -0.08 0.08" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="30" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <link name="right_shoulder_pitch_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/shoulder_joint.stl"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="right_shoulder_roll" type="revolute">
    <parent link="right_shoulder_pitch_link"/>
    <child link="right_upper_arm_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <link name="right_upper_arm_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/upper_arm.stl"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.12" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="right_elbow" type="revolute">
    <parent link="right_upper_arm_link"/>
    <child link="right_lower_arm_link"/>
    <origin xyz="0 -0.06 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="20" velocity="1.0" lower="-1.57" upper="0"/>
  </joint>

  <link name="right_lower_arm_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/lower_arm.stl"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <!-- Left Leg (3 DOF) -->
  <joint name="left_hip_yaw" type="revolute">
    <parent link="torso_roll_link"/>
    <child link="left_hip_yaw_link"/>
    <origin xyz="0.1 -0.05 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="60" velocity="1.0" lower="-0.5" upper="0.5"/>
  </joint>

  <link name="left_hip_yaw_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/hip_joint.stl"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.08 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="left_hip_pitch" type="revolute">
    <parent link="left_hip_yaw_link"/>
    <child name="left_upper_leg_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="80" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <link name="left_upper_leg_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/upper_leg.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.3" radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="left_knee" type="revolute">
    <parent link="left_upper_leg_link"/>
    <child link="left_lower_leg_link"/>
    <origin xyz="0 0 -0.15" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="60" velocity="1.0" lower="0" upper="2.0"/>
  </joint>

  <link name="left_lower_leg_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/lower_leg.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.3" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.015"/>
    </inertial>
  </link>

  <!-- Right Leg (3 DOF) - mirror of left -->
  <joint name="right_hip_yaw" type="revolute">
    <parent link="torso_roll_link"/>
    <child link="right_hip_yaw_link"/>
    <origin xyz="-0.1 -0.05 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="60" velocity="1.0" lower="-0.5" upper="0.5"/>
  </joint>

  <link name="right_hip_yaw_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/hip_joint.stl"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.08 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="right_hip_pitch" type="revolute">
    <parent link="right_hip_yaw_link"/>
    <child name="right_upper_leg_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="80" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

  <link name="right_upper_leg_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/upper_leg.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.3" radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="right_knee" type="revolute">
    <parent link="right_upper_leg_link"/>
    <child link="right_lower_leg_link"/>
    <origin xyz="0 0 -0.15" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="60" velocity="1.0" lower="0" upper="2.0"/>
  </joint>

  <link name="right_lower_leg_link">
    <visual>
      <geometry>
        <mesh filename="package://transformer_description/meshes/lower_leg.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.3" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.015"/>
    </inertial>
  </link>

  <!-- Transmissions for ROS2 Control -->
  <transmission name="torso_yaw_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="torso_yaw">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="torso_yaw_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="torso_pitch_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="torso_pitch">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="torso_pitch_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="torso_roll_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="torso_roll">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="torso_roll_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="head_pan_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="head_pan">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="head_pan_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="head_tilt_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="head_tilt">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="head_tilt_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_shoulder_pitch_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_shoulder_pitch">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_shoulder_pitch_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_shoulder_roll_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_shoulder_roll">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_shoulder_roll_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_elbow_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_elbow">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_elbow_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_shoulder_pitch_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_shoulder_pitch">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_shoulder_pitch_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_shoulder_roll_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_shoulder_roll">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_shoulder_roll_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_elbow_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_elbow">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_elbow_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_hip_yaw_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_hip_yaw">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_hip_yaw_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_hip_pitch_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_hip_pitch">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_hip_pitch_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="left_knee_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_knee">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_knee_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_hip_yaw_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_hip_yaw">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_hip_yaw_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_hip_pitch_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_hip_pitch">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_hip_pitch_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_knee_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_knee">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_knee_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

</robot>
